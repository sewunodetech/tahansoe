# Simnet environment (docs/specs/m1-simulation-mode.md §3.10). Copy to .env; never commit .env.

# Arbitrum One RPC used as the fork source and for the Chainlink ETH/USD relay.
# The public endpoint works to start; use a free Alchemy/Infura key if rate limited.
ARB_ONE_RPC_URL=https://arb1.arbitrum.io/rpc

# Shared secret the web server sends as `x-simnet-key`. Generate with: openssl rand -hex 32
SIMNET_API_KEY=

SIM_CHAIN_ID=4216199
SIM_MAX_PRIVATE_FORKS=4
# Idle minutes before an unused private fork is reclaimed (any API or RPC call resets it).
SIM_PRIVATE_TTL_MIN=30
SIM_PORT=8787

# Optional
# SIM_ANVIL_BIN=anvil
# SIM_FORGE_BIN=forge
# SIM_CONTRACTS_DIR=../../contracts
# SIM_SCENARIOS_DIR=./scenarios
# Set to 1 only behind Cloudflare Tunnel / a reverse proxy, so rate limits use the real client IP.
# SIM_TRUST_PROXY=0
