# Core Risk Engine — environment (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Salin ke apps/engine/.env dan isi. Script npm engine memuatnya otomatis
# (tsx --env-file-if-exists=.env). File .env di-gitignore (security.md I8).
#
# PENTING: file ini HANYA untuk SECRET (API key, DATABASE_URL) + sakelar operasional.
# Konfigurasi NON-RAHASIA LLM (provider, base URL, model per peran, pricing URL,
# harga manual) ada di settings.json — lihat apps/engine/settings.example.json
# dan CLI `tsx src/cli/settings.ts show`. Nilai LLM_* lama MASIH didukung sebagai
# fallback deprecated (ada peringatan), tetapi sebaiknya pindah ke settings.json.

# --- Database (dipakai context builder, settlement, reflection; sama dengan web app).
DATABASE_URL=postgresql://user:password@host/dbname

# --- API key LLM per provider. KOSONG = provider dianggap TIDAK tersedia.
# Nama env var ini dirujuk dari settings.json lewat "apiKeyEnv" (bukan nilainya).
# Bynara / router OpenAI-compatible generik — key dari dashboard provider.
LLM_API_KEY=
# Google Gemini — key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (opsional) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq (opsional) — https://console.groq.com/keys
GROQ_API_KEY=
# Anthropic (opsional; butuh kredit API, bukan langganan Claude Pro)
ANTHROPIC_API_KEY=

# --- Sumber data research agents.
# FRED: key gratis dari https://fredaccount.stlouisfed.org (menu API Keys). Kosong = FRED dilewati.
FRED_API_KEY=
# RPC Arbitrum One untuk data on-chain. Kosong = RPC publik https://arb1.arbitrum.io/rpc.
ARBITRUM_RPC_URL=

# --- Sakelar & batas operasional.
# Batas biaya LLM harian (USD). Jika terlampaui, lapis riset berhenti sampai besok;
# modul sinyal & fusion tetap jalan. Usulan R&D: 5. Gemini free tier = $0.
LLM_DAILY_BUDGET_USD=5
# Kill switch research agents. Default false. Set "true" untuk mengaktifkan.
RESEARCH_ENABLED=false
# GDELT opsional (rate limit ketat); default mati.
RESEARCH_GDELT_ENABLED=false

# --- (Opsional) Override lokasi file settings non-rahasia.
# TAHANSOE_SETTINGS=/path/ke/settings.json
