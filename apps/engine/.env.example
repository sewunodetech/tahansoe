# Core Risk Engine — environment (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Salin ke apps/engine/.env dan isi. Script npm engine memuatnya otomatis
# (tsx --env-file-if-exists=.env). File .env di-gitignore (security.md I8).

# Dipakai context builder, settlement, reflection (sama dengan web app).
DATABASE_URL=postgresql://user:password@host/dbname

# --- LLM providers (ADR 0008). Server-only. Provider tanpa key dianggap TIDAK tersedia.
# Isi minimal satu. Untuk R&D, Gemini free tier direkomendasikan.
# Anthropic (opsional; butuh kredit API, bukan langganan Claude Pro).
ANTHROPIC_API_KEY=
# Google Gemini — endpoint OpenAI-compatible. Key dari https://aistudio.google.com/apikey
GEMINI_API_KEY=
# OpenRouter (opsional) — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Groq (opsional) — https://console.groq.com/keys
GROQ_API_KEY=
# Ollama lokal (opsional) — tanpa key; base URL OpenAI-compatible.
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Provider OpenAI-compatible GENERIK (router/endpoint apa pun).
# Set API URL & key di sini; semua peran bisa pakai model dari provider ini.
# LLM_BASE_URL boleh ditulis sampai ".../v1" ATAU ".../v1/chat/completions"
# (dinormalisasi otomatis). Contoh nyata (Bynara):
#   LLM_BASE_URL=https://router.bynara.id/v1/chat/completions
#   LLM_API_KEY=<key-bynara-anda>        # JANGAN commit key asli
#   LLM_PROVIDER_NAME=bynara             # nama provider utk "nama:model" (default "custom")
#   LLM_MODEL=deepseek-v4.1-flash        # model default semua peran bila LLM_<PERAN> kosong
LLM_BASE_URL=
LLM_API_KEY=
LLM_PROVIDER_NAME=custom
LLM_MODEL=

# Provider generik TAMBAHAN (opsional): LLM_PROVIDER_<NAMA>_BASE_URL + _API_KEY.
# Contoh: LLM_PROVIDER_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
#         LLM_PROVIDER_DEEPSEEK_API_KEY=<key>

# --- Harga model (opsional) untuk estimasi biaya di CLI `src/cli/models.ts`.
# (a) LLM_PRICING_URL — daftar harga remote. Dua format dideteksi otomatis:
#     - Bynara:     https://router.bynara.id/api/pricing  (PUBLIK; credit/1k = IDR, + usd_to_idr)
#     - OpenRouter: https://openrouter.ai/api/v1/models   (USD per token)
LLM_PRICING_URL=
# (b) LLM_MODEL_PRICES — harga manual (JSON), USD per 1 JUTA token. Menimpa remote.
#     Contoh: {"deepseek-v4.1-flash":{"inputPerM":0.3,"outputPerM":1.2}}
LLM_MODEL_PRICES=

# Pemilihan provider:model per peran (ADR 0008). Format: "provider:model,provider:model"
# (daftar fallback dipisah koma). Kosong = default (Gemini bila ada, lalu Anthropic).
# Contoh: LLM_ANALYST=gemini:gemini-flash-lite-latest,groq:llama-3.3-70b-versatile
LLM_ANALYST=
LLM_DEBATE=
LLM_ASSESSOR=
LLM_REFLECTOR=

# Batas biaya LLM harian (USD). Jika terlampaui, lapis riset berhenti sampai besok;
# modul sinyal & fusion tetap jalan (spec §3.4). Usulan R&D: 5. Gemini free tier = $0.
LLM_DAILY_BUDGET_USD=5

# Kill switch research agents. Default false. Set "true" untuk mengaktifkan (spec §3.9).
RESEARCH_ENABLED=false

# Sumber data research agents (spec §3.10): gratis & kredibel.
# FRED: key gratis dari https://fredaccount.stlouisfed.org (menu API Keys). Kosong = FRED dilewati.
FRED_API_KEY=
# GDELT opsional (rate limit ketat); default mati.
RESEARCH_GDELT_ENABLED=false
# RPC Arbitrum One untuk data on-chain. Kosong = RPC publik https://arb1.arbitrum.io/rpc.
ARBITRUM_RPC_URL=
