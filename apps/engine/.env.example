# Core Risk Engine — environment (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Salin ke apps/engine/.env dan isi. Script npm engine memuatnya otomatis
# (tsx --env-file-if-exists=.env). File .env di-gitignore (security.md I8).

# Dipakai context builder, settlement, reflection (sama dengan web app).
DATABASE_URL=postgresql://user:password@host/dbname

# Research agents & klasifikasi berita. Server-only.
ANTHROPIC_API_KEY=

# Batas biaya LLM harian (USD). Jika terlampaui, lapis riset berhenti sampai besok;
# modul sinyal & fusion tetap jalan (spec §3.4). Usulan R&D: 5 (cukup untuk tier Haiku).
LLM_DAILY_BUDGET_USD=5

# Kill switch research agents. Default false. Set "true" untuk mengaktifkan (spec §3.9).
RESEARCH_ENABLED=false

# Sumber data research agents (spec §3.10): gratis & kredibel.
# FRED: key gratis dari https://fredaccount.stlouisfed.org (menu API Keys). Kosong = FRED dilewati.
FRED_API_KEY=
# GDELT opsional (rate limit ketat); default mati.
RESEARCH_GDELT_ENABLED=false
# RPC Arbitrum One untuk data on-chain. Kosong = RPC publik https://arb1.arbitrum.io/rpc.
ARBITRUM_RPC_URL=
