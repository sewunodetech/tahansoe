# Core Risk Engine — environment (server-only, JANGAN pakai prefix NEXT_PUBLIC_).
# Salin ke apps/engine/.env dan isi. Script npm engine memuatnya otomatis
# (tsx --env-file-if-exists=.env). File .env di-gitignore (security.md I8).
#
# PENTING: file ini HANYA untuk SECRET + sakelar operasional. Model per peran,
# pricing URL, dan harga manual ada di settings.json (non-rahasia) — lihat
# apps/engine/settings.example.json dan `tsx src/cli/settings.ts show`.

# --- Database (ADR 0010: DB_DRIVER="neon" | "pglite")
# Driver "neon" (default jika DATABASE_URL diisi): Postgres cloud untuk web & server
DATABASE_URL=postgresql://user:password@host/dbname
# Driver "pglite": Postgres embedded (WASM) tanpa server/akun, cocok untuk CLI lokal/offline
# DB_DRIVER=pglite
# PGLITE_DATA_DIR=apps/engine/.data/pglite

# --- LLM gateway OpenAI-compatible TUNGGAL (ADR 0009). Hanya DUA nilai ini.
# Semua model dipanggil lewat satu endpoint; ganti provider = ganti URL + key.
# URL boleh ".../v1" atau ".../v1/chat/completions" (dinormalisasi otomatis).
LLM_API_URL=https://router.bynara.id/v1
# API key gateway (JANGAN commit nilai asli; tidak pernah di-log).
LLM_API_KEY=

# --- Sumber data research agents.
# FRED: key gratis dari https://fredaccount.stlouisfed.org (menu API Keys). Kosong = FRED dilewati.
FRED_API_KEY=
# RPC Arbitrum One untuk data on-chain. Kosong = RPC publik https://arb1.arbitrum.io/rpc.
ARBITRUM_RPC_URL=

# --- Sakelar & batas operasional.
# Batas biaya LLM harian (USD). Jika terlampaui, lapis riset berhenti sampai besok;
# modul sinyal & fusion tetap jalan. Usulan R&D: 5.
LLM_DAILY_BUDGET_USD=5
# Kill switch research agents. Default false. Set "true" untuk mengaktifkan.
RESEARCH_ENABLED=false
# GDELT opsional (rate limit ketat); default mati.
RESEARCH_GDELT_ENABLED=false

# --- (Opsional) Override lokasi file settings non-rahasia.
# TAHANSOE_SETTINGS=/path/ke/settings.json
