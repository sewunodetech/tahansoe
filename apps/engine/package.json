{
  "name": "@tahansoe/engine",
  "version": "0.1.0",
  "private": true,
  "description": "Core Risk Engine — research agents (multi-agent) + reflection loop. Lihat docs/specs/m3-research-agents.md.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/all.test.ts",
    "research:run": "tsx --env-file-if-exists=.env src/index.ts",
    "research:dry": "tsx --env-file-if-exists=.env src/agents/run.ts --dry",
    "reflect:settle": "tsx --env-file-if-exists=.env src/reflection/settle.ts",
    "reflect:daily": "tsx --env-file-if-exists=.env src/reflection/reflect.ts",
    "scorecard": "tsx --env-file-if-exists=.env src/reflection/scorecard.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.132.1",
    "@tahansoe/db": "*",
    "@tahansoe/domain": "*",
    "viem": "^2.55.19",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^20",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
