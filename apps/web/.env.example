# Tahansoe web — environment. Salin ke apps/web/.env dan isi.
# File .env di-gitignore (security.md I8). Hanya variabel ber-prefix NEXT_PUBLIC_
# yang masuk ke bundle browser; sisanya server-only.

# --- Wajib
DATABASE_URL=
SESSION_SECRET=
NEXT_PUBLIC_APP_DOMAIN=

# --- Opsional: Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# --- Opsional: WalletConnect
NEXT_PUBLIC_WC_PROJECT_ID=

# --- Opsional: Simulation Mode (docs/specs/m1-simulation-mode.md §3.10)
# Session API apps/simnet. SERVER-ONLY: jangan pernah diberi prefix NEXT_PUBLIC_.
SIMNET_URL=
SIMNET_API_KEY=
# Base URL publik RPC proxy simnet; path fork per sesi ditambahkan di browser.
NEXT_PUBLIC_SIM_RPC_BASE=
# Chain id fork simulasi (default 4216199).
NEXT_PUBLIC_SIM_CHAIN_ID=
# 1 = respons simnet palsu (tanpa layanan simnet) untuk develop/demo UI.
SIMNET_MOCK=
