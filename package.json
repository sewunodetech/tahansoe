{
  "name": "tahansoe",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @tahansoe/web --",
    "build": "npm run build -w @tahansoe/web",
    "start": "npm run start -w @tahansoe/web",
    "lint": "npm run lint -w @tahansoe/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "tahansoe": "npm run tahansoe -w @tahansoe/engine --",
    "db:migrate": "tsx packages/db/scripts/migrate.ts",
    "db:check": "tsx packages/db/scripts/check-db.ts",
    "db:reset": "tsx packages/db/scripts/reset-db.ts",
    "db:fix-telegram": "tsx packages/db/scripts/fix-telegram.ts"
  },
  "devDependencies": {
    "dotenv": "^17.4.2",
    "tsx": "^4.20.6",
    "typescript": "^5"
  }
}
